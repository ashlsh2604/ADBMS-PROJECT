# Server
PORT=3000
# Production requires MySQL unless DEMO_MODE=true. Development defaults to demo mode.
DEMO_MODE=false
APP_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# MySQL (used when DEMO_MODE=false)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ashrides26_db
# Optional URL alternative:
# MYSQL_URL=mysql://root:password@127.0.0.1:3306/ashrides26_db

# Hosts the admin connection tester may contact. Defaults to MYSQL_HOST.
MYSQL_ALLOWED_HOSTS=127.0.0.1

# Optional first owner account, created only when dim_users is empty.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Channel Owner
